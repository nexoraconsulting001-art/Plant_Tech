# Copy to deploy/.env on the VM and fill in. Never commit the real .env.
# Every setting the server reads is in backend/settings.py; the ones a VM needs are here.

# Which server this is: staging or production (production refuses to start on unsafe settings)
ENV=staging

# MongoDB: compose.yaml points MONGO_URL at its own replica set. Production on Atlas: set the mongodb+srv:// URL
# of the app's own database user here (it wins over compose.yaml) and stop the mongo service.
# MONGO_URL=
DB_NAME=nurserypos

# Claude API - https://console.anthropic.com/settings/keys (separate production and staging workspaces)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Per kind of call; empty = CLAUDE_MODEL (decision D5: Haiku for plant photos once approved)
CLAUDE_MODEL_PLANT=
CLAUDE_MODEL_INVOICE=
CLAUDE_MODEL_NAMES=
CLAUDE_EFFORT_PLANT=low
CLAUDE_EFFORT_INVOICE=medium

# Signs login tokens. At least 32 random characters: openssl rand -hex 32
JWT_SECRET=

# Public addresses (no host names in code). Bill links sent on WhatsApp use PUBLIC_BASE_URL.
PUBLIC_BASE_URL=https://nurserypos.140-238-251-141.sslip.io
PUBLIC_IMAGE_BASE_URL=
# Web browsers allowed to call the API (comma-separated). Required in production; the phone app sends no Origin.
CORS_ORIGINS=

# Google sign-in (owners): comma-separated OAuth client IDs (web + Android). Empty = Google button off.
GOOGLE_CLIENT_IDS=

# App admins (manage the shared picture library): comma-separated phone numbers
ADMIN_PHONES=

# AI scans allowed per shop per day
AI_DAILY_LIMIT=300

# Staging only: PROJECT_NAME=nurserypos-staging, HOST_PORT=8130, STORAGE_PREFIX=nurserypos-staging
# PROJECT_NAME=nurserypos
# HOST_PORT=8120

# Photo storage: "r2" (Cloudflare R2) or "local" (VM disk, /data/uploads). Production must use r2.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nurserypos-photos

# Phone notifications to shop owners (low stock, daily summary) through Expo. Off unless set to 1.
# EXPO_ACCESS_TOKEN only if "enhanced push security" is on for the Expo project. See docs/PUSH-SETUP.md.
PUSH_ENABLED=0
EXPO_ACCESS_TOKEN=

# Errors and metrics: Sentry project DSN (empty = off); /metrics also answers "Authorization: Bearer <METRICS_TOKEN>"
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=
LOG_LEVEL=INFO
# API worker processes (2 on the shared VM; about one per vCPU on a dedicated one)
WEB_CONCURRENCY=2

# Oldest app version still served (GET /api/config); 1.1.0 is never asked to update
MIN_APP_VERSION=1.1.0
# Open owner decisions, kept at today's behaviour (docs/PRODUCTION-PLAN.md section 4)
BILL_WITHOUT_GST=1
OTP_REQUIRED=0

# --- deploy/deploy.sh -------------------------------------------------------------------------------------------
# build = build the image on the VM (default); ghcr = pull the arm64 image GitHub Actions built for the commit
# (the VM then needs: echo <read:packages token> | docker login ghcr.io -u <user> --password-stdin)
IMAGE_SOURCE=build
GHCR_IMAGE=
# ghcr.io/<owner>/hara-hisaab-api

# --- deploy/backup.sh (docs/RUNBOOK.md, Backups) -------------------------------------------------------------------
# age public key(s), one per line, in this file; the private key stays OFF the VM
BACKUP_AGE_RECIPIENTS_FILE=
# rclone remote and folder, e.g. r2-backup:hara-hisaab-backups/prod (remote set up with `rclone config`)
BACKUP_RCLONE_REMOTE=
# heartbeat URLs (Better Stack / Healthchecks.io): pinged after every good backup / on a failure
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=
BACKUP_KEEP_DAYS=14
