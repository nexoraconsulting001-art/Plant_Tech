# Copy to deploy/.env on the VM and fill in. Never commit the real .env.
# Every setting the server reads is in backend/settings.py; the ones a VM needs are here.

# Which server this is: staging or production (production refuses to start on unsafe settings)
ENV=staging

# MongoDB: compose.yaml points MONGO_URL at its own replica set. Production on Atlas: set the mongodb+srv:// URL
# of the app's own database user here (it wins over compose.yaml) and stop the mongo service.
# MONGO_URL=
DB_NAME=nurserypos

# Claude API - https://console.anthropic.com/settings/keys (separate production and staging workspaces)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Per kind of call; empty = CLAUDE_MODEL (decision D5: Haiku for plant photos once approved)
CLAUDE_MODEL_PLANT=
CLAUDE_MODEL_INVOICE=
CLAUDE_MODEL_NAMES=
CLAUDE_EFFORT_PLANT=low
CLAUDE_EFFORT_INVOICE=medium

# Signs login tokens. At least 32 random characters: openssl rand -hex 32
JWT_SECRET=

# Public addresses (no host names in code). Bill links sent on WhatsApp use PUBLIC_BASE_URL.
PUBLIC_BASE_URL=https://nurserypos.140-238-251-141.sslip.io
PUBLIC_IMAGE_BASE_URL=
# Web browsers allowed to call the API (comma-separated). Required in production; the phone app sends no Origin.
CORS_ORIGINS=

# Google sign-in (owners): comma-separated OAuth client IDs (web + Android). Empty = Google button off.
GOOGLE_CLIENT_IDS=

# App admins (manage the shared picture library) are a flag on the login, not this setting. ADMIN_PHONES (comma-
# separated phone numbers) is read once, by migration 0801, and flags only logins that exist when it runs: keep it
# on a server whose admin already has a login. A new admin, or any admin on a new database, signs up first and then
# gets the flag by hand: docker compose run --rm migrate python -m manage_users admin grant <phone> (RUNBOOK.md)
ADMIN_PHONES=

# AI scans allowed per shop per day
AI_DAILY_LIMIT=300

# Staging only: PROJECT_NAME=nurserypos-staging, HOST_PORT=8130, STORAGE_PREFIX=nurserypos-staging
# PROJECT_NAME=nurserypos
# HOST_PORT=8120

# Photo storage: "r2" (Cloudflare R2) or "local" (VM disk, /data/uploads). Production must use r2.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nurserypos-photos

# Phone notifications to shop owners (low stock, daily summary) through Expo. Off unless set to 1.
# EXPO_ACCESS_TOKEN only if "enhanced push security" is on for the Expo project. See docs/PUSH-SETUP.md.
PUSH_ENABLED=0
EXPO_ACCESS_TOKEN=

# Errors and metrics: Sentry project DSN (empty = off); /metrics also answers "Authorization: Bearer <METRICS_TOKEN>"
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=
LOG_LEVEL=INFO
# API worker processes (2 on the shared VM; about one per vCPU on a dedicated one)
WEB_CONCURRENCY=2
# Overload protection (backend/overload.py, RUNBOOK section 7). Requests one worker works on at once; more get
# 503 "busy" with Retry-After at once and the app tries again. 0 = twice MONGO_MAX_POOL_SIZE (50 with the default 25).
MAX_IN_FLIGHT=0
# CPUs the web container may use (compose.yaml). At most the VM's CPU count: Docker refuses more. 1 on the
# shared VM; e.g. 4 on a dedicated 4-OCPU production VM.
WEB_CPUS=1
# MongoDB connections per worker, and the limit (ms) on one database call including the wait for a connection;
# over it the request gets 503 "db_busy" instead of waiting. Long jobs (migrations, rollups rebuild) set their own.
MONGO_MAX_POOL_SIZE=25
MONGO_TIMEOUT_MS=5000

# Oldest app version still served (GET /api/config); 1.1.0 is never asked to update
MIN_APP_VERSION=1.1.0
# Open owner decisions, kept at today's behaviour (docs/PRODUCTION-PLAN.md section 4)
BILL_WITHOUT_GST=1
OTP_REQUIRED=0

# --- Switches and limits added by the production work packages (default in brackets; leave commented) -----------
# Reports read the daily rollups (WP-2). Migration 0202 fills them and every bill keeps them up to date; bills the
# old version made during a deploy (or after a rollback) are added by deploy.sh's rebuild after the swap. [off]
REPORTS_FROM_ROLLUPS=1
# Login tokens (WP-8): issuer and audience written into new tokens; older tokens without them keep working
# JWT_ISSUER=hara-hisaab
# JWT_AUDIENCE=hara-hisaab-app
# bcrypt threads per process [2]; seconds a login's user record is cached [30]; owner account deletion wait [30 days]
# AUTH_THREADS=2
# USER_CACHE_SECONDS=30
# ACCOUNT_DELETE_GRACE_DAYS=30
# Days a shared bill link keeps working [180]
# BILL_LINK_DAYS=180
# Claude (WP-6): monthly spend in US dollars after which scans stop with a clear message [0 = no limit]
AI_MONTHLY_BUDGET_USD=0
# Scans per user [20/minute]; calls at once per process [8] and across all processes through Redis [32];
# seconds a scan waits for a free slot before "busy" [10]; photo decodes at once per process [2]
# AI_USER_RATE=20/minute
# AI_MAX_CONCURRENCY=8
# AI_GLOBAL_CONCURRENCY=32
# AI_QUEUE_WAIT_SECONDS=10
# AI_DECODE_CONCURRENCY=2
# Circuit breaker: opens after this many failed calls in a row [10], tries one call again after [30] seconds
# AI_BREAKER_FAILURES=10
# AI_BREAKER_RESET_SECONDS=30
# Plant photo long edge sent to Claude [1568]; 1024 goes with Haiku (decision D5). Prompt cache minimum [512 tokens]
# AI_IMAGE_EDGE_PLANT=1568
# AI_CACHE_MIN_TOKENS=512
# Days the per-call AI log (ai_calls) is kept; read by migration 0601's TTL index [180]
# AI_CALLS_KEEP_DAYS=180
# Photos (WP-7): bucket for product photos and logos, served from PUBLIC_IMAGE_BASE_URL; bill scans stay in
# R2_BUCKET. FILES_SERVE=proxy turns the redirects off everywhere [auto]. Presigned link lifetime [600 s].
R2_PUBLIC_BUCKET=
# FILES_SERVE=auto
# FILES_LINK_SECONDS=600
# Uploads per user [60/minute] and per shop [2000/day]; storage per shop [5120 MB]
# UPLOAD_RATE_USER=60/minute
# UPLOAD_RATE_SHOP=2000/day
# UPLOAD_QUOTA_MB=5120
# Worker (WP-5): pinged after every good once-a-minute tick (Better Stack / Healthchecks.io). Empty = off.
HEARTBEAT_URL=
# 1.1.0 removes its push token without a login; set 0 once 1.1.0 is retired [1]
# PUSH_REMOVE_LEGACY=1
# Compliance (WP-10): audit log in its own database [the main one]; buckets for the daily audit archive and the
# shop exports [R2_BUCKET]
# AUDIT_DB=
# AUDIT_ARCHIVE_BUCKET=
# EXPORT_BUCKET=
# Seconds gunicorn lets one request run [150]; a bill scan can take two minutes
# GUNICORN_TIMEOUT=150

# --- deploy/deploy.sh -------------------------------------------------------------------------------------------
# build = build the image on the VM (default); ghcr = pull the arm64 image GitHub Actions built for the commit
# (the VM then needs: echo <read:packages token> | docker login ghcr.io -u <user> --password-stdin)
IMAGE_SOURCE=build
GHCR_IMAGE=
# ghcr.io/<owner>/hara-hisaab-api

# --- deploy/backup.sh (docs/RUNBOOK.md, Backups) -------------------------------------------------------------------
# age public key(s), one per line, in this file; the private key stays OFF the VM
BACKUP_AGE_RECIPIENTS_FILE=
# rclone remote and folder, e.g. r2-backup:hara-hisaab-backups/prod (remote set up with `rclone config`)
BACKUP_RCLONE_REMOTE=
# heartbeat URLs (Better Stack / Healthchecks.io): pinged after every good backup / on a failure
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=
BACKUP_KEEP_DAYS=14
