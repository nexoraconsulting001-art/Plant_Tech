# Local dev only (npx expo start). Copy to frontend/.env.
# APK builds take these from eas.json + EAS environment variables instead.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:8001

# Optional (WP-13). EAS builds read these from the EAS environment of their profile.
# Crash reports: Sentry DSN of the app project (empty = off) and the share of sessions traced (0 to 1)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Privacy policy and terms links on the More tab (the server's /api/config can override; empty = hidden)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Build time only: a production build refuses an http:// or IP / sslip.io backend address unless this is 1
# ALLOW_IP_BACKEND_URL=1
