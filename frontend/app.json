{
  "expo": {
    "name": "Hara Hisaab",
    "slug": "nurserypos",
    "owner": "shashank_jindal",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nurserypos",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0ff8f95c-6822-4a2e-83d7-38bf03e117f6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.planteck.nurserypos",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Scan plants and invoices to bill faster",
        "NSPhotoLibraryUsageDescription": "Add product photos from your gallery",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "upi",
          "tel"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
